# Stores the passphrase in the login Keychain, which is why macOS rarely asks.
pinentry-program /opt/homebrew/bin/pinentry-mac

# Kept in sync with the Linux config so the two behave the same when the
# Keychain entry is absent, for example right after a fresh setup.
default-cache-ttl 34560000
max-cache-ttl 34560000
default-cache-ttl-ssh 34560000
max-cache-ttl-ssh 34560000
