# GUI dialog, so non-interactive callers (IDE, Claude Code) can still prompt.
pinentry-program /usr/bin/pinentry-gnome3

# Linux has no Keychain equivalent to persist the passphrase, so the cache is
# widened to 400 days instead. Both the default and the maximum have to be set:
# max-cache-ttl caps the total lifetime no matter how often the entry is reused.
# The cache still dies with the agent, i.e. on reboot or `gpgconf --kill`.
default-cache-ttl 34560000
max-cache-ttl 34560000
default-cache-ttl-ssh 34560000
max-cache-ttl-ssh 34560000
